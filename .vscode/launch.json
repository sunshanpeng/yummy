{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: CLI",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/yummy",
      "args": ["version"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Go: Control",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/yummy-server",
      "args": ["serve", "--allow-local-http"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "dev:infra",
      "env": {
        "GOPROXY": "https://goproxy.cn,https://proxy.golang.org,direct",
        "DATABASE_URL": "postgres://demo:demo@localhost:5432/demo?sslmode=disable",
        "REDIS_ADDR": "localhost:6379",
        "PUBLIC_ADDR": "127.0.0.1:8080"
      }
    },
    {
      "name": "Go: Worker",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/yummy-worker",
      "args": [
        "run",
        "--state-dir", "${env:STATE_DIR}",
        "--kube-apiserver", "${env:KUBE_APISERVER}",
        "--kube-ca-file", "${env:KUBE_CA_FILE}",
        "--kube-token-file", "${env:KUBE_TOKEN_FILE}",
        "--node-name", "${env:NODE_NAME}",
        "--build-namespace", "${env:BUILD_NAMESPACE}",
        "--runtime-namespace", "${env:RUNTIME_NAMESPACE}"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "GOPROXY": "https://goproxy.cn,https://proxy.golang.org,direct"
      }
    },
    {
      "name": "Web: Vite Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --dir web dev",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Go: Control + Worker",
      "configurations": ["Go: Control", "Go: Worker"],
      "stopAll": true
    },
    {
      "name": "前后端分离 (Control + Vite)",
      "configurations": ["Go: Control", "Web: Vite Dev"],
      "stopAll": true
    }
  ]
}
